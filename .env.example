# Файл для запуска на своём компьютере или VPS.
# На GitHub эти же значения задаются в Settings → Secrets and variables → Actions.

# --- Нейросеть ---
# gemini (бесплатный тариф) | openrouter | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Модели можно не задавать — для каждого провайдера стоят свои по умолчанию
MODEL_FAST=
MODEL_WRITER=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_ADMIN_CHAT_ID=

# --- Режим ---
# moderate — черновики тебе с кнопками; auto — сразу в канал
MODE=moderate
# posts — готовые посты для канала; briefs — только выжимки фактов
OUTPUT=posts
# 1 — проверенные посты сами уходят в канал; 0 — ждут кнопки «Опубликовать»
AUTOPUBLISH=0
# сколько часов тяжёлая новость (погибшие, насилие) ждёт второе издание
HOLD_HEAVY_HOURS=3
DRY_RUN=0

# --- Отбор ---
MIN_SCORE=7
MAX_AGE_HOURS=36
MAX_LLM_ITEMS_PER_SCAN=10

# --- Расписание (время Вьетнама) ---
SCAN_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=10
MIN_GAP_MIN=45
QUIET_FROM=23
QUIET_TO=7
TZ_NAME=Asia/Ho_Chi_Minh

# --- Оформление ---
CHANNEL_SIGNATURE=
# ссылка в конце поста
SUBSCRIBE_TEXT=Подписаться на Вьетнам новости
SUBSCRIBE_URL=https://t.me/novosti_vietnama
# Например: «1 000 донгов ≈ … ₽; 1 $ ≈ … донгов» — впиши актуальный курс
RATES=

DB_PATH=news.db
KEEP_DAYS=14
